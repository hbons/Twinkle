<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="studio.planetpeanut.SparkleShare" path="/studio/planetpeanut/SparkleShare/">
        <!-- Author -->
        <key name="author-avatar" type="s">
            <default>''</default>
        </key>

        <key name="author-name" type="s">
            <default>'Anonymous'</default>
        </key>
        <key name="author-email" type="s">
            <default>'git@localhost'</default>
        </key>


        <!-- Sync -->
        <key name="polling-interval" type="i">
            <default>60</default>
        </key>

        <key name="sync-in-background" type="b">
            <default>true</default>
        </key>
        <key name="sync-on-startup" type="b">
            <default>true</default>
        </key>
    </schema>
</schemalist>
